generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Users ----
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  avatarUrl String?
  role      UserRole @default(member)

  // Google OAuth tokens (encrypted at app level)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleScopes       String?

  businesses Business[]
  jobs       Job[]
  settings   UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

enum UserRole {
  owner
  admin
  member
}

// ---- Businesses ----
model Business {
  id               String  @id @default(cuid())
  userId           String
  googleAccountId  String
  googleLocationId String
  name             String
  address          String?
  phone            String?
  website          String?
  category         String?
  averageRating    Float   @default(0)
  totalReviews     Int     @default(0)

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews   Review[]
  posts     BusinessPost[]
  metrics   BusinessMetricDaily[]
  syncState BusinessSyncState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleLocationId])
  @@index([userId])
  @@map("businesses")
}

// ---- Reviews ----
model Review {
  id               String    @id @default(cuid())
  businessId       String
  googleReviewId   String    @unique
  authorName       String
  authorPhotoUrl   String?
  rating           Int
  comment          String?
  replyComment     String?
  repliedAt        DateTime?
  aiSuggestedReply String?
  reviewedAt       DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, repliedAt])
  @@index([reviewedAt])
  @@map("reviews")
}

// ---- Business Posts ----
model BusinessPost {
  id               String    @id @default(cuid())
  businessId       String
  googlePostId     String    @unique
  languageCode     String?
  summary          String?
  topicType        String?
  state            String?
  searchUrl        String?
  callToActionType String?
  callToActionUrl  String?
  eventTitle       String?
  offerTitle       String?
  publishedAt      DateTime?
  updatedAtSource  DateTime?
  rawPayload       Json

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId, publishedAt])
  @@index([businessId, updatedAtSource])
  @@map("business_posts")
}

// ---- Business Metrics ----
model BusinessMetricDaily {
  id            String   @id @default(cuid())
  businessId    String
  metric        String
  metricLabel   String?
  subEntityType String   @default("ALL")
  date          DateTime
  value         Int

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, metric, subEntityType, date])
  @@index([businessId, date])
  @@index([businessId, metric, date])
  @@map("business_metric_daily")
}

// ---- Sync State ----
model BusinessSyncState {
  id                  String     @id @default(cuid())
  businessId          String     @unique
  initialSyncStatus   SyncStatus @default(pending)
  reviewsSyncStatus   SyncStatus @default(pending)
  postsSyncStatus     SyncStatus @default(pending)
  metricsSyncStatus   SyncStatus @default(pending)
  initialSyncMonths   Int        @default(3)
  lastReviewSyncAt    DateTime?
  lastPostSyncAt      DateTime?
  lastMetricSyncAt    DateTime?
  reviewsBackfilledAt DateTime?
  postsBackfilledAt   DateTime?
  metricsBackfilledAt DateTime?
  lastError           String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_sync_states")
}

// ---- Jobs (async processing queue) ----
model Job {
  id          String    @id @default(cuid())
  type        JobType
  status      JobStatus @default(pending)
  payload     Json      @default("{}")
  result      Json?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  userId      String
  lockedAt    DateTime?
  lockedBy    String?
  runAt       DateTime  @default(now())
  dedupeKey   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, type])
  @@index([status, runAt])
  @@index([dedupeKey])
  @@index([userId])
  @@index([createdAt])
  @@map("jobs")
}

enum JobType {
  sync_business_initial
  sync_business_incremental
  sync_reviews_page
  sync_posts_page
  sync_metrics_range
  generate_ai_reply
  send_report
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

enum SyncStatus {
  pending
  syncing
  completed
  failed
}

// ---- User Settings ----
model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  autoReplyEnabled   Boolean @default(false)
  emailNotifications Boolean @default(true)
  theme              String  @default("system")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}
